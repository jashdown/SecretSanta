# Backs up the Patton Secret Santa database. Started nightly by
# patton-secret-santa-backup.timer; see deploy/README.md to install.
[Unit]
Description=Back up the Patton Secret Santa database

[Service]
Type=oneshot
Environment="BACKUP_DIR=/home/jashdown/Network/network/Justin's Stuff/secretSantaBackup"
Environment=BACKUP_OWNER=jashdown
ExecStart=/usr/local/sbin/patton-secret-santa-backup
