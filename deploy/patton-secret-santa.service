# systemd service for Patton Secret Santa. Starts at boot and restarts if it crashes.
# Install: sudo cp /opt/patton-secret-santa/deploy/patton-secret-santa.service /etc/systemd/system/
[Unit]
Description=Patton Secret Santa
After=network-online.target
Wants=network-online.target

[Service]
User=santa
Group=santa
WorkingDirectory=/opt/patton-secret-santa
ExecStart=/usr/bin/node node_modules/@react-router/serve/bin.cjs build/server/index.js
Restart=always
RestartSec=5

# Defaults. Anything in the settings file below overrides these.
Environment=NODE_ENV=production
# Only reachable through Apache, not directly from the network.
Environment=HOST=127.0.0.1
Environment=PORT=3000
# systemd creates /var/lib/patton-secret-santa, owned by the santa user.
StateDirectory=patton-secret-santa
StateDirectoryMode=0700
Environment=DATABASE_PATH=/var/lib/patton-secret-santa/secret-santa.db
# Passwords and SMTP settings. Read by systemd as root, so it can be root-only.
EnvironmentFile=/etc/patton-secret-santa.env

# The app only needs to write to its database folder.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
