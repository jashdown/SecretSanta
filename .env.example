# Copy this file to .env and fill it in. Variables set in the shell take precedence.

# Password for the organizer pages. Required in production.
# In development it defaults to "admin" when left empty.
ADMIN_PASSWORD=

# Random string that signs the login cookie. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database is stored.
# DATABASE_PATH=data/secret-santa.db

# In production the login cookie is HTTPS-only. If you serve the app over
# plain http (for example on a home network), set this to false.
# COOKIE_SECURE=false

# Email (SMTP). Leave SMTP_HOST empty and emails are printed to the server
# console instead of being sent, which is handy for trying things out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to true for port 465; other ports upgrade with STARTTLS.
# SMTP_SECURE=true
MAIL_FROM="Patton Secret Santa <santa@example.com>"
